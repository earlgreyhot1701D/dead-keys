    "text": {
      "type": "string",
      "minLength": 1,
      "description": "What the player types."
    },
    "kind": {
      "type": "string",
      "enum": ["word", "sentence", "number", "mixed", "pair"]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "A citation, or the word original."
    }
  }
}
