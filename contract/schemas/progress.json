{
  "type": "object",
  "description": "Progress (PRD G4, G9). Everything saved in the browser under deadkeys:v1. rules.js checks schemaVersion first: older means needs-migration, newer means invalid.",
  "required": [
    "schemaVersion",
    "createdAt",
    "rounds",
    "keys",
    "bests",
    "dayStreak",
    "lessonsPassed",
    "milestones",
    "settings",
    "ghosts"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "description": "Epoch milliseconds."
    },
    "rounds": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "roundResult.json" }
    },
    "keys": {
      "type": "array",
      "items": { "$ref": "keyStat.json" }
    },
    "bests": {
      "type": "object",
      "description": "Personal bests: the highest WPM per mode, with the round's date. Mode names are not checked here (the schema subset has no propertyNames).",
      "additionalProperties": {
        "type": "object",
        "required": ["wpm", "date"],
        "additionalProperties": false,
        "properties": {
          "wpm": { "type": "number", "minimum": 0 },
          "date": { "type": "integer", "minimum": 0, "description": "Epoch milliseconds." }
        }
      }
    },
    "dayStreak": {
      "type": "object",
      "description": "Days in a row with at least one round. Kept here, not worked out from rounds, because only the last 200 rounds are saved.",
      "required": ["lastDay", "count"],
      "additionalProperties": false,
      "properties": {
        "lastDay": {
          "type": ["string", "null"],
          "minLength": 10,
          "maxLength": 10,
          "description": "The player's last local day with a round, YYYY-MM-DD. Null before the first round. The format itself is checked by updateDayStreak (the schema subset has no pattern)."
        },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "lessonsPassed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lessonId", "how"],
        "additionalProperties": false,
        "properties": {
          "lessonId": {
            "type": "string",
            "minLength": 1
          },
          "how": {
            "type": "string",
            "enum": ["lesson", "testout"]
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": { "$ref": "milestone.json" }
    },
    "settings": {
      "type": "object",
      "description": "Player settings. Loose until Block 6 (shell UI) defines it."
    },
    "ghosts": {
      "type": "array",
      "items": { "$ref": "ghostRun.json" }
    }
  }
}
