{
  "name": "dead-keys",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "A typing game, back from the dead.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "test": "node --test",
    "test:e2e": "playwright test",
    "check:build": "vite build && node scripts/check-build.js",
    "deploy:preview": "npm run check:build && vercel deploy --environment=preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "@playwright/test": "1.64.1",
    "fast-check": "4.10.2",
    "vercel": "65.5.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1160.0",
    "@aws-sdk/credential-provider-web-identity": "3.972.85"
  }
}
